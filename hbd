import math
import random
import time
import tkinter as tk
import tkinter.font as tkfont
import turtle

W, H = 760, 840
BG = (0, 0, 0)

TIERS = [(4, 330), (6, 510), (9, 680)]
ROWS = sum(n for n, _ in TIERS)
ROW_GAP = 24
TIER_GAP = 10
ROW_Y0 = -140
MIN_GAP = 7
MAX_GAP = 22

SIZES = [9, 10, 10, 11, 12, 13, 15]

N_CANDLES = 5
CANDLE_SPAN = 260
CANDLE_BASE_Y = ROW_Y0 - 30
CANDLE_H = [112, 106, 102, 108, 114]

PHRASES = [
    "Happy Birthday", "İyi ki doğdun", "Feliz cumpleaños", "Joyeux anniversaire",
    "Alles Gute zum Geburtstag", "Buon compleanno", "Feliz aniversário",
    "С днём рождения", "생일 축하해요", "お誕生日おめでとう", "生日快乐",
    "जन्मदिन मुबारक हो", "Χρόνια πολλά", "Gefeliciteerd", "Grattis på födelsedagen",
    "Wszystkiego najlepszego", "สุขสันต์วันเกิด", "Chúc mừng sinh nhật",
    "Selamat ulang tahun", "З днем народження", "عيد ميلاد سعيد", "יום הולדת שמח",
    "Tillykke med fødselsdagen", "Všechno nejlepší",
]
GRADIENT = [
    (0.00, (225, 228, 255)),
    (0.18, (125, 170, 255)),
    (0.42, (150, 120, 255)),
    (0.68, (235, 90, 200)),
    (0.88, (255, 100, 150)),
    (1.00, (255, 225, 200)),
]
T_POP = 0.8
FADE_SPREAD, FADE_IN = 1.6, 1.4
T_BLOW = T_POP + FADE_SPREAD + FADE_IN + 1.6
BLOW_STEP = 0.85
T_VANISH = T_BLOW + BLOW_STEP * N_CANDLES + 0.4
V_SPAN, V_JITTER, V_DUR = 5.0, 1.8, 0.4
T_END = T_VANISH + V_SPAN + V_JITTER + V_DUR + 0.6
def clamp(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def mix(c1, c2, t):
    return tuple(a + (b - a) * t for a, b in zip(c1, c2))


def hexc(c):
    return "#%02x%02x%02x" % tuple(int(clamp(v, 0, 255)) for v in c)


def gradient(t):
    for (t0, c0), (t1, c1) in zip(GRADIENT, GRADIENT[1:]):
        if t <= t1:
            return mix(c0, c1, (t - t0) / (t1 - t0))
    return GRADIENT[-1][1]

s = turtle.Screen()
s.setup(W, H)
s.title("Happy Birthday")
s.bgcolor("black")
s.tracer(0)
cv = s.getcanvas()

rng = random.Random(11)


def pick_family():
    fams = set(tkfont.families(root=cv))
    for name in ("Segoe UI", "Noto Sans", "Arial Unicode MS", "Arial"):
        if name in fams:
            return name
    return "Helvetica"


FAMILY = pick_family()
_fonts = {}


def font(size, bold):
    key = (size, bold)
    if key not in _fonts:
        _fonts[key] = tkfont.Font(root=cv, family=FAMILY, size=size,
                                  weight="bold" if bold else "normal")
    return _fonts[key]

words = []
candles = []
state = {"t0": time.time(), "hint": None, "alive": True}


def build_words():
    """Fill every row with greetings so the rows form a pyramid."""
    layout = [(width, k) for k, (n, width) in enumerate(TIERS) for _ in range(n)]
    for r, (target, tier) in enumerate(layout):
        frac = r / (ROWS - 1)
        base = gradient(frac)

        row, used = [], 0
        for _ in range(60):
            p = rng.choice(PHRASES)
            if row and p == row[-1][0]:
                continue
            size, bold = rng.choice(SIZES), rng.random() < 0.55
            w = font(size, bold).measure(p)
            if used + w + MIN_GAP * len(row) > target:
                if target - (used + MIN_GAP * len(row)) < 30:
                    break          # row is full enough
                continue
            row.append((p, size, bold, w))
            used += w
        if not row:
            p = PHRASES[0]
            row.append((p, 10, False, font(10, False).measure(p)))
            used = row[0][3]

        n = len(row)
        gap = min(MAX_GAP, (target - used) / (n - 1)) if n > 1 else 0
        total = used + gap * (n - 1)
        x = -total / 2
        y = ROW_Y0 + r * ROW_GAP + tier * TIER_GAP
        for p, size, bold, w in row:
            col = mix(base, (255, 255, 255), rng.uniform(0, 0.25))
            item = cv.create_text(x, y, text=p, anchor="w",
                                  font=font(size, bold), fill=hexc(BG))
            words.append(dict(
                item=item, color=col, last=None,
                at=T_POP + rng.uniform(0, FADE_SPREAD),
                vt=T_VANISH + frac * V_SPAN + rng.uniform(0, V_JITTER)))
            x += w + gap


def build_candles():
    for i in range(N_CANDLES):
        x = -CANDLE_SPAN / 2 + i * CANDLE_SPAN / (N_CANDLES - 1)
        top = CANDLE_BASE_Y - CANDLE_H[i]
        stick = cv.create_line(x, CANDLE_BASE_Y, x, top, width=4, fill=hexc(BG))
        stripes = cv.create_line(x, CANDLE_BASE_Y, x, top, width=4,
                                 dash=(2, 7), fill=hexc(BG))
        dot = cv.create_oval(x + 29, CANDLE_BASE_Y + 12, x + 35, CANDLE_BASE_Y + 18,
                             fill=hexc(BG), outline="")
        halo1 = cv.create_oval(0, 0, 0, 0, fill=hexc((58, 24, 10)), outline="", state="hidden")
        halo2 = cv.create_oval(0, 0, 0, 0, fill=hexc((110, 44, 14)), outline="", state="hidden")
        body = cv.create_polygon(0, 0, 0, 0, 0, 0, smooth=True,
                                 fill=hexc((255, 122, 40)), outline="", state="hidden")
        core = cv.create_polygon(0, 0, 0, 0, 0, 0, smooth=True,
                                 fill=hexc((255, 214, 130)), outline="", state="hidden")
        candles.append(dict(x=x, top=top, stick=stick, stripes=stripes, dot=dot,
                            halo1=halo1, halo2=halo2, body=body, core=core,
                            flame_on=False, stick_last=None))


def restart():
    global rng
    if state["t0"] != 0:
        rng = random.Random(int(time.time()))
    cv.delete("all")
    words.clear()
    candles.clear()
    state["hint"] = None
    build_words()
    build_candles()
    state["t0"] = time.time()

TEAR = [(0, -1.7), (0.42, -0.7), (0.62, 0.05), (0.38, 0.65),
        (0, 0.8), (-0.38, 0.65), (-0.62, 0.05), (-0.42, -0.7)]


def teardrop(cx, cy, k, sway, dy=0.0):
    pts = []
    for px, py in TEAR:
        pts += [cx + (px + sway * max(0.0, -py)) * k, cy + (py + dy) * k]
    return pts


def draw_flame(cd, t, i, lit):
    if lit <= 0.02:
        if cd["flame_on"]:
            for key in ("halo1", "halo2", "body", "core"):
                cv.itemconfigure(cd[key], state="hidden")
            cd["flame_on"] = False
        return
    flick = 1 + 0.10 * math.sin(t * 17 + i * 1.3) + 0.05 * math.sin(t * 41 + i * 5)
    sway = 0.18 * math.sin(t * 9 + i * 2.1) + 0.08 * math.sin(t * 23 + i)
    k = 9 * lit * flick
    cx, cy = cd["x"], cd["top"] - 12

    cv.coords(cd["halo1"], cx - 2.4 * k, cy - 2.9 * k, cx + 2.4 * k, cy + 2.3 * k)
    cv.coords(cd["halo2"], cx - 1.5 * k, cy - 2.0 * k, cx + 1.5 * k, cy + 1.6 * k)
    cv.coords(cd["body"], *teardrop(cx, cy, k, sway))
    cv.coords(cd["core"], *teardrop(cx, cy + 0.25 * k, k * 0.5, sway * 0.5))
    if not cd["flame_on"]:
        for key in ("halo1", "halo2", "body", "core"):
            cv.itemconfigure(cd[key], state="normal")
        cd["flame_on"] = True


def tick():
    if not state["alive"]:
        return
    try:
        t = time.time() - state["t0"]

        # words
        for w in words:
            a_in = clamp((t - w["at"]) / FADE_IN)
            a = a_in * (1 - clamp((t - w["vt"]) / V_DUR))
            if a != w["last"]:
                cv.itemconfigure(w["item"], fill=hexc(mix(BG, w["color"], a)))
                w["last"] = a

        # candles
        for i, cd in enumerate(candles):
            t_out = T_BLOW + i * BLOW_STEP
            appear = clamp((t - T_POP) / (FADE_SPREAD + FADE_IN))
            stick_a = appear * (1 - clamp((t - (t_out + 0.5)) / 0.5))
            if stick_a != cd["stick_last"]:
                cv.itemconfigure(cd["stick"], fill=hexc(mix(BG, (60, 150, 255), stick_a)))
                cv.itemconfigure(cd["stripes"], fill=hexc(mix(BG, (235, 242, 255), stick_a)))
                cv.itemconfigure(cd["dot"], fill=hexc(mix(BG, (255, 70, 50), stick_a)))
                cd["stick_last"] = stick_a
            lit = appear * (1 - clamp((t - t_out) / 0.25))
            draw_flame(cd, t, i, lit)

        # replay hint
        if t > T_END and state["hint"] is None:
            state["hint"] = cv.create_text(0, H / 2 - 40, text="press SPACE to replay",
                                           fill="#555555", font=font(11, False))

        s.update()
        s.ontimer(tick, 16)
    except (turtle.Terminator, tk.TclError):
        state["alive"] = False


def quit_app():
    state["alive"] = False
    try:
        s.bye()
    except Exception:
        pass


def main():
    try:    
        import ctypes
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        pass
    state["t0"] = 0
    restart()
    s.listen()
    s.onkey(restart, "space")
    s.onkey(quit_app, "Escape")
    tick()
    try:
        s.mainloop()
    except (turtle.Terminator, tk.TclError):
        pass


if __name__ == "__main__":
    main()
